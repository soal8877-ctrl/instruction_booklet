# Neon PostgreSQL connection string
# Получите в Neon Console: https://console.neon.tech
# Для Vercel используйте pooled connection (с ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js
AUTH_SECRET="сгенерируйте: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Локальная PostgreSQL для утилиты view-db (опционально)
LOCAL_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME"
